{
  "name": "learning-site-editor",
  "version": "1.2.1",
  "description": "Secure desktop editor for Learning Site projects",
  "author": "Learning Site",
  "private": true,
  "main": "dist-electron/learning-site-editor/electron/main.js",
  "type": "module",
  "scripts": {
    "postinstall": "electron-builder install-app-deps",
    "dev": "concurrently -k \"vite\" \"tsc -p tsconfig.electron.json -w\" \"wait-on tcp:5173 && electron .\"",
    "build": "tsc -p tsconfig.electron.json && vite build",
    "lint": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run",
    "package": "npm run build && electron-builder --publish never",
    "release": "npm run lint && npm test && npm run package"
  },
  "dependencies": {
    "@learning-site/engine": "file:../learning-site-engine",
    "@learning-site/themes": "file:../learning-site-themes",
    "electron-updater": "^6.6.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.1.2",
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.learningsite.editor",
    "productName": "Learning Site Editor",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../learning-site-themes",
        "to": "themes",
        "filter": [
          "registry.json",
          "themes/**"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "galtauba",
        "repo": "learning-site-editor"
      }
    ]
  }
}
